<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Same exclusions as backup_rules.xml, for both cloud backup and device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="cloud_accounts_prefs.xml" />
        <exclude domain="file" path="mae/" />
        <exclude domain="file" path="flux/" />
        <exclude domain="file" path="ca.psiphon.PsiphonTunnel.tunnel-core" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cloud_accounts_prefs.xml" />
        <exclude domain="file" path="mae/" />
        <exclude domain="file" path="flux/" />
        <exclude domain="file" path="ca.psiphon.PsiphonTunnel.tunnel-core" />
    </device-transfer>
</data-extraction-rules>
