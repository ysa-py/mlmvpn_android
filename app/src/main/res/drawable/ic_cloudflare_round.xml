    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <!-- The tile, in Cloudflare orange, inset the same 51.2 as the squircle. -->
    <path
        android:pathData="M512,51.2a460.8,460.8 0 1,0 0.1,0z"
        android:fillColor="#F38020" />

