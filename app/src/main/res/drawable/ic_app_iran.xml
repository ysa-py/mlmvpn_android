<?xml version="1.0" encoding="utf-8"?>
<!--
    The Iran configs tile.

    The supplied mark is the outline of the country, drawn as a single filled path in near-black
    with no background of its own. A bare silhouette dropped into a grid of squircles reads as a
    rendering fault rather than as an icon, so it is seated on the same squircle every other tile
    uses - white, as asked, which is also the only ground this mark can sit on: it is one solid
    dark shape, so any tint dark enough to be a colour would swallow it.

    See HomeApp.imageRes: a tile with artwork gets no coloured background drawn behind it, so the
    squircle has to be part of the asset. The squircle spans 51.2..972.8 of a 1024 box - a 90%
    inset, which is the convention every shipped icon here follows and which AppIcon's TileFace
    scales back up by 100/90.

    The mark itself is the source path unaltered. Only the group transform is ours: measured
    bounds of the path are 21.591 x 19.058 in its own 21.477 viewport, scaled to fill 60% of the
    squircle's width and centred on the box. Sixty rather than more because this is a silhouette
    with fine coastline detail along the south - pushed larger it crowds the corners and the
    detail closes up at grid size.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- The tile. White, so the dark mark reads at grid size. -->
    <path
        android:pathData="M651.264 51.2c92.16 0 138.24 0 188.416 15.36 54.272 19.456 97.28 62.464 116.736 116.736C972.8 233.472 972.8 280.576 972.8 372.736v278.528c0 92.16 0 138.24-15.36 188.416-19.456 54.272-62.464 97.28-116.736 116.736-51.2 16.384-97.28 16.384-189.44 16.384H372.736c-92.16 0-138.24 0-188.416-15.36-55.296-20.48-97.28-62.464-117.76-117.76C51.2 790.528 51.2 744.448 51.2 651.264V372.736c0-92.16 0-138.24 15.36-188.416 20.48-54.272 62.464-97.28 117.76-116.736C233.472 51.2 279.552 51.2 372.736 51.2h278.528z"
        android:fillColor="#FFFFFF" />

    <!-- The country, exactly as supplied. -->
