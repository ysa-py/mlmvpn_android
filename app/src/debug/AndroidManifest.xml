<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: the Game Booster lab. Exported so `adb shell am broadcast` can reach it;
    this manifest is merged into debug builds and never into release.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver android:name=".openvpn.OpenVpnSmokeReceiver"
            android:exported="true" android:permission="android.permission.DUMP" />
        <receiver
            android:name=".gblab.GameLabReceiver"
            android:exported="true" />
    </application>
</manifest>
